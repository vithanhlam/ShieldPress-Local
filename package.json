{
  "name": "shieldpresslocal",
  "productName": "ShieldPress Local",
  "version": "2.5.27",
  "description": "ShieldPress Local Development Environment Manager",
  "main": "app/main.js",
  "author": {
    "name": "vithanhlam",
    "email": "vithanhlam@users.noreply.github.com"
  },
  "homepage": "https://shieldpress.net",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "bash scripts/prepare-vc-redist.sh && electron-builder --win nsis --x64",
    "dist:linux": "bash scripts/build-linux.sh",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^6.0.1",
    "basic-ftp": "^6.0.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0",
    "ssh2": "^1.17.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shieldpress.local",
    "productName": "ShieldPress Local",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/ssh2/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "assets/installer.nsh"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development"
    }
  }
}
